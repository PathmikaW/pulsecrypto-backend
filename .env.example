# Every variable has a default (src/config/env.ts) and none is a secret: no API key is needed,
# only Binance's public market-data endpoints are used. Copy this file to .env to override any of them.
NODE_ENV=development
PORT=3000

# Always-included, mandatory pairs
REQUIRED_PAIRS=BTCUSDT,ETHUSDT,SOLUSDT,DOGEUSDT,XRPUSDT
# Additional pairs resolved by live liquidity at startup
EXTRA_PAIRS_COUNT=3
# Timeout for pair resolution and for the /pairs/meta request to Binance; on timeout the
# required pairs only (resolution) or mock data (metadata) is used
PAIR_RESOLUTION_TIMEOUT_MS=5000

# Order book levels used in the pressure calculation (ADR-B5) — deliberately decoupled
# from the Binance subscription depth (@depth20)
ORDER_BOOK_PRESSURE_DEPTH=10

# Conflation tick / broadcast interval — also the basis for the mobile client's liveness
# timeout (ADR-M6)
BROADCAST_INTERVAL_MS=100

# Per-client backpressure threshold (ADR-B4)
MAX_BUFFERED_BYTES=65536
# Ticks a client can be skipped before eviction (ADR-B4)
MAX_CONSECUTIVE_SKIPS=10

# --- Optional. The values shown are the defaults. ---

# Binance endpoints, overridable for tests or a testnet
#BINANCE_REST_BASE_URL=https://api.binance.com
#BINANCE_WS_BASE_URL=wss://stream.binance.com:9443/stream

# Comma-separated CORS and WebSocket Origin allowlist. Empty = unrestricted, which is fine locally
# (native mobile clients send no meaningful Origin) but should be set for a real deployment (ADR-B9)
#ALLOWED_ORIGINS=

# REST rate limit per client IP
#RATE_LIMIT_MAX=100
#RATE_LIMIT_WINDOW_MS=60000

# Concurrent WebSocket connections allowed per client IP. Each client receives about 126 KB/s,
# so lower this on a publicly reachable host
#MAX_CONNECTIONS_PER_IP=5
