NODE_ENV=development
PORT=3000

# Always-included, mandatory pairs
REQUIRED_PAIRS=BTCUSDT,ETHUSDT,SOLUSDT,DOGEUSDT,XRPUSDT
# Additional pairs resolved by live liquidity at startup
EXTRA_PAIRS_COUNT=3
# Timeout before falling back to required pairs only
PAIR_RESOLUTION_TIMEOUT_MS=5000

# Order book levels used in the pressure calculation (ADR-B5) — deliberately decoupled
# from the Binance subscription depth (@depth20)
ORDER_BOOK_PRESSURE_DEPTH=10

# Conflation tick / broadcast interval — also the basis for the mobile client's liveness
# timeout (ADR-M6)
BROADCAST_INTERVAL_MS=100

# Per-client backpressure threshold (ADR-B4)
MAX_BUFFERED_BYTES=65536
# Ticks a client can be skipped before eviction (ADR-B4)
MAX_CONSECUTIVE_SKIPS=10
